{
  "name": "Kumbh360 Pilgrim Companion",
  "short_name": "Kumbh360",
  "description": "Live crowd management, AI assistant, SOS alerts, and navigation for Kumbh Mela pilgrims.",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "start_url": "/?source=pwa",
  "scope": "/",
  "background_color": "#FF7F00",
  "theme_color": "#FF7F00",
  "orientation": "portrait-primary",
  "lang": "en",
  "categories": ["navigation", "travel", "utilities"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "SOS Alert",
      "short_name": "SOS",
      "description": "Send an emergency SOS alert",
      "url": "/sos?source=shortcut",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Live Map",
      "short_name": "Map",
      "description": "View crowd density map",
      "url": "/map?source=shortcut",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "AI Assistant",
      "short_name": "Chat",
      "description": "Ask the Kumbh Mela AI assistant",
      "url": "/?source=shortcut#chat",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "screenshots": [
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Kumbh360 home dashboard"
    }
  ],
  "prefer_related_applications": false
}
